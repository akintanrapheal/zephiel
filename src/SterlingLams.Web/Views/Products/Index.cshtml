@model SterlingLams.Web.Models.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = Model.PageTitle ?? "Collections";
    Layout = "_Layout";

    // Base URL (current filters, minus page) for the "View more" progressive-load button.
    var qsParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Filters.Category)) { qsParts.Add("category=" + Uri.EscapeDataString(Model.Filters.Category)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.SortBy)) { qsParts.Add("sortBy=" + Uri.EscapeDataString(Model.Filters.SortBy)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.Search)) { qsParts.Add("search=" + Uri.EscapeDataString(Model.Filters.Search)); }
    if (!string.IsNullOrWhiteSpace(Model.Filters.Metal)) { qsParts.Add("metal=" + Uri.EscapeDataString(Model.Filters.Metal)); }
    if (Model.Filters.MinPrice.HasValue) { qsParts.Add("minPrice=" + Model.Filters.MinPrice.Value); }
    if (Model.Filters.MaxPrice.HasValue) { qsParts.Add("maxPrice=" + Model.Filters.MaxPrice.Value); }
    if (Model.Filters.InStockOnly == true) { qsParts.Add("inStockOnly=true"); }
    var loadMoreBaseUrl = "/products" + (qsParts.Count > 0 ? "?" + string.Join("&", qsParts) : "");
    var shownNow = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    // Grouped "Shop Categories" tree (old-site style), built from the categories that have products.
    var sidebarNodes = SterlingLams.Web.Infrastructure.StoreMenu.BuildSidebar(
        Model.Filters.Categories.Select(c => (c.Slug, c.Name)));

    // Sort options + a URL builder that preserves every active filter and swaps only sortBy.
    var sortOptions = new (string V, string L)[]
    {
        ("newest", "Newest"),
        ("price_asc", "Price: Low to High"),
        ("price_desc", "Price: High to Low"),
        ("name", "Name"),
    };
    var currentSort = string.IsNullOrWhiteSpace(Model.Filters.SortBy) ? "newest" : Model.Filters.SortBy;
    string SortUrl(string sort)
    {
        var p = new List<string>();
        if (!string.IsNullOrWhiteSpace(Model.Filters.Category)) p.Add("category=" + Uri.EscapeDataString(Model.Filters.Category));
        if (!string.IsNullOrWhiteSpace(Model.Filters.Search)) p.Add("search=" + Uri.EscapeDataString(Model.Filters.Search));
        if (!string.IsNullOrWhiteSpace(Model.Filters.Metal)) p.Add("metal=" + Uri.EscapeDataString(Model.Filters.Metal));
        if (Model.Filters.MinPrice.HasValue) p.Add("minPrice=" + Model.Filters.MinPrice.Value);
        if (Model.Filters.MaxPrice.HasValue) p.Add("maxPrice=" + Model.Filters.MaxPrice.Value);
        if (Model.Filters.InStockOnly == true) p.Add("inStockOnly=true");
        p.Add("sortBy=" + sort);
        return "/products?" + string.Join("&", p);
    }
    var hasActiveFilters = !string.IsNullOrEmpty(Model.Filters.Category) || !string.IsNullOrEmpty(Model.Filters.Metal)
        || Model.Filters.MinPrice.HasValue || Model.Filters.MaxPrice.HasValue || Model.Filters.InStockOnly == true;

    // Self-canonical that keeps the category but drops page/sort/filter noise (avoids duplicates).
    var canonBase = $"{Context.Request.Scheme}://{Context.Request.Host}/products";
    ViewData["Canonical"] = string.IsNullOrWhiteSpace(Model.Filters.Category)
        ? canonBase
        : $"{canonBase}?category={Model.Filters.Category}";

    // BreadcrumbList structured data (OP-39): Home > Collections, or Home > <Category> on a filtered view.
    var sdBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var hasCategory = !string.IsNullOrWhiteSpace(Model.Filters.Category);
    var crumbLeafName = hasCategory ? (Model.PageTitle ?? "Collections") : "Collections";
    var crumbLeafUrl = hasCategory ? $"{sdBase}/products?category={Model.Filters.Category}" : $"{sdBase}/products";
    var breadcrumbLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = sdBase },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = crumbLeafName, ["item"] = crumbLeafUrl },
        },
    });
}

@section Head {
    <script type="application/ld+json" nonce="@Context.Items["csp-nonce"]">@Html.Raw(breadcrumbLd)</script>
}

<div id="listing-root" class="max-w-[110rem] mx-auto px-4 sm:px-6 lg:px-10 py-10">
    @* Antiforgery token comes from _QuickViewModal's placeholder (filled by /site/header-state)
       so this page stays output-cacheable — no server-rendered token / Set-Cookie. *@
    <partial name="_QuickViewModal" />

    <!-- ─── Toolbar: Sort · Count · Title · In-stock · Filters ──────────────── -->
    <div class="border-b border-neutral-200 pb-6 mb-10 flex flex-col gap-5 lg:grid lg:grid-cols-3 lg:items-center">

        <!-- Left: Sort + product count -->
        <div class="flex items-center gap-4 sm:gap-6 order-2 lg:order-1">
            <div class="relative" id="sort-dd">
                <button type="button" id="sort-toggle" aria-haspopup="true" aria-expanded="false"
                        class="flex items-center gap-3 border border-neutral-300 px-5 py-3 text-[11px] tracking-[0.22em] uppercase text-neutral-700 hover:border-neutral-900 transition-colors">
                    Sort By
                    <svg class="w-3 h-3 text-neutral-500 transition-transform" id="sort-caret" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="sort-menu" class="hidden absolute left-0 top-full mt-1 w-56 bg-white border border-neutral-200 shadow-[0_18px_50px_-12px_rgba(0,0,0,0.25)] z-40 py-1">
                    @foreach (var (v, l) in sortOptions)
                    {
                        <a href="@SortUrl(v)"
                           class="flex items-center justify-between px-4 py-2.5 text-[12px] tracking-[0.08em] uppercase @(currentSort == v ? "text-neutral-900 font-medium" : "text-neutral-500") hover:bg-neutral-50 transition-colors">
                            @l
                            @if (currentSort == v)
                            {
                                <span class="text-brand-500">✓</span>
                            }
                        </a>
                    }
                </div>
            </div>
            <span class="hidden sm:inline text-[11px] tracking-[0.2em] uppercase text-neutral-500 whitespace-nowrap">@Model.TotalCount Products</span>
        </div>

        <!-- Center: page title -->
        <h1 class="order-1 lg:order-2 text-center lg:justify-self-center font-bodoni text-4xl lg:text-5xl font-light text-neutral-900">
            @(Model.PageTitle ?? "All Jewellery")
        </h1>

        <!-- Right: In-stock toggle + Filters -->
        <div class="flex items-center justify-between lg:justify-end gap-5 sm:gap-7 order-3 lg:justify-self-end">
            <label class="flex items-center gap-2.5 cursor-pointer text-[11px] tracking-[0.2em] uppercase text-neutral-700 select-none">
                <input type="checkbox" name="inStockOnly" value="true" form="filter-form" data-autosubmit
                       @(Model.Filters.InStockOnly == true ? "checked" : "")
                       class="w-4 h-4 rounded-none border-neutral-400 text-brand-500 focus:ring-brand-500 focus:ring-offset-0" />
                In Stock
            </label>
            <button type="button" id="filter-open" aria-controls="filter-drawer"
                    class="flex items-center gap-3 border border-neutral-300 px-5 py-3 text-[11px] tracking-[0.22em] uppercase text-neutral-700 hover:border-neutral-900 transition-colors">
                Filters
                @if (hasActiveFilters)
                {
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
                }
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4.5h18M6 12h12M10 19.5h4"/></svg>
            </button>
        </div>
    </div>

    <!-- ─── Product grid ───────────────────────────────────────────────────── -->
    @if (!Model.Products.Any())
    {
        <div class="text-center py-28">
            <p class="font-bodoni text-3xl font-light text-neutral-400">No pieces found</p>
            <p class="text-sm text-neutral-400 mt-3">Try adjusting your filters.</p>
            @if (hasActiveFilters)
            {
                <a asp-action="Index" class="inline-block mt-6 text-xs tracking-[0.2em] uppercase text-neutral-700 border-b border-neutral-300 pb-1 hover:text-brand-500 hover:border-brand-500 transition-colors">Clear all filters</a>
            }
        </div>
    }
    else
    {
        <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 lg:gap-x-8 lg:gap-y-16">
            <partial name="_ProductCards" model="Model.Products" />
        </div>

        <!-- Progressive "View more" (appends the next page in place) + Back to top -->
        <div class="mt-16 flex flex-col items-center gap-8">
            <p class="text-sm text-neutral-500">
                Showing 1–<span id="shown-count">@shownNow</span> of @Model.TotalCount
            </p>
            @if (Model.Page < Model.TotalPages)
            {
                <div id="load-more-wrap" class="w-full max-w-xl">
                    <button type="button" id="load-more-btn"
                            data-url="@loadMoreBaseUrl" data-next="@(Model.Page + 1)" data-total="@Model.TotalPages"
                            data-count="@Model.TotalCount" data-size="@Model.PageSize"
                            class="w-full border border-neutral-300 py-4 text-xs tracking-[0.2em] uppercase text-neutral-800 hover:bg-neutral-900 hover:border-neutral-900 hover:text-white transition-colors">
                        <span data-label>View more</span>
                    </button>
                </div>
            }
            <button type="button" id="back-to-top"
                    class="flex items-center gap-2 text-xs tracking-[0.2em] uppercase text-neutral-700 hover:text-neutral-900 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M5 12l7-7 7 7" />
                </svg>
                Back to top
            </button>
        </div>
    }
</div>

<!-- ─── Filters drawer (slide-over) ────────────────────────────────────────── -->
<div id="filter-drawer" class="fixed inset-0 z-[150] hidden" role="dialog" aria-modal="true" aria-label="Filters">
    <div id="filter-backdrop" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-300"></div>
    <aside id="filter-panel"
           class="absolute right-0 top-0 h-full w-full max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out">
        <!-- Header -->
        <div class="flex items-center justify-between px-6 py-5 border-b border-neutral-200">
            <h2 class="font-bodoni text-2xl font-light text-neutral-900">Filters</h2>
            <button type="button" id="filter-close" aria-label="Close filters"
                    class="text-neutral-500 hover:text-neutral-900 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <!-- Scrollable body -->
        <form method="get" id="filter-form" action="/products" class="flex-1 overflow-y-auto px-6 py-6">
            @* Preserve context that isn't an editable field in this form. *@
            @if (!string.IsNullOrWhiteSpace(Model.Filters.Category)) { <input type="hidden" name="category" value="@Model.Filters.Category" /> }
            @if (!string.IsNullOrWhiteSpace(Model.Filters.Search)) { <input type="hidden" name="search" value="@Model.Filters.Search" /> }
            <input type="hidden" name="sortBy" value="@currentSort" />

            <!-- Shop Categories -->
            @if (sidebarNodes.Count > 0)
            {
                <div class="mb-8">
                    <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Shop Categories</h3>
                    <partial name="_CategorySidebar" model="@((sidebarNodes, Model.Filters.Category))" />
                </div>
            }

            <!-- Metal -->
            @if (Model.Filters.AvailableMetals.Any())
            {
                <div class="mb-8">
                    <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Metal</h3>
                    <ul class="space-y-2.5">
                        @foreach (var metal in Model.Filters.AvailableMetals)
                        {
                            <li>
                                <label class="flex items-center gap-2.5 text-sm text-neutral-600 cursor-pointer hover:text-neutral-900 transition-colors">
                                    <input type="checkbox" name="metal" value="@metal"
                                           @(Model.Filters.Metal == metal ? "checked" : "")
                                           class="rounded-none border-neutral-300 text-brand-500 focus:ring-brand-500 focus:ring-offset-0" />
                                    @metal
                                </label>
                            </li>
                        }
                    </ul>
                </div>
            }

            <!-- Price Range -->
            <div class="mb-8">
                <h3 class="text-xs tracking-[0.2em] uppercase text-neutral-600 font-semibold mb-4">Price</h3>
                <div class="flex items-center gap-3">
                    <input type="number" name="minPrice" value="@Model.Filters.MinPrice" placeholder="Min ₦"
                           class="w-full border border-neutral-200 text-sm px-3 py-2.5 focus:outline-none focus:border-neutral-900" />
                    <span class="text-neutral-300">—</span>
                    <input type="number" name="maxPrice" value="@Model.Filters.MaxPrice" placeholder="Max ₦"
                           class="w-full border border-neutral-200 text-sm px-3 py-2.5 focus:outline-none focus:border-neutral-900" />
                </div>
            </div>
        </form>

        <!-- Footer actions -->
        <div class="border-t border-neutral-200 px-6 py-5 flex items-center gap-3">
            @if (hasActiveFilters)
            {
                <a asp-action="Index" class="flex-shrink-0 text-xs tracking-[0.2em] uppercase text-neutral-500 hover:text-brand-500 transition-colors">Clear all</a>
            }
            <button type="submit" form="filter-form"
                    class="flex-1 bg-neutral-900 text-white text-xs tracking-[0.2em] uppercase py-3.5 hover:bg-brand-500 transition-colors">
                Apply
            </button>
        </div>
    </aside>
</div>

<!-- ─── Product detail slide-over (opens over the dimmed listing) ──────────── -->
<style>
    #listing-root { transition: opacity .35s ease, transform .35s ease; transform-origin: left center; }
    #listing-root.pdp-dimmed { opacity: .5; transform: scale(.986); }
</style>
<div id="pdp-overlay" class="fixed inset-0 z-[160] hidden" role="dialog" aria-modal="true" aria-label="Product">
    <div id="pdp-scrim" class="absolute inset-0 bg-white/45 backdrop-blur-[1px] opacity-0 transition-opacity duration-300"></div>
    <div id="pdp-panel"
         class="absolute top-0 right-0 h-full w-full lg:w-[calc(100%-11rem)] bg-canvas shadow-[-24px_0_70px_-24px_rgba(0,0,0,0.4)] translate-x-full transition-transform duration-300 ease-out overflow-y-auto overscroll-contain">
        <div id="pdp-content"></div>
        <div id="pdp-loading" class="absolute inset-0 flex items-center justify-center bg-canvas">
            <span class="w-8 h-8 border-2 border-neutral-300 border-t-neutral-800 rounded-full animate-spin"></span>
        </div>
    </div>
</div>

@section Scripts {
<script nonce="@Context.Items["csp-nonce"]">
// Sort dropdown — open/close, click-outside, Esc.
(function () {
    var dd = document.getElementById('sort-dd');
    if (!dd) return;
    var btn = document.getElementById('sort-toggle');
    var menu = document.getElementById('sort-menu');
    var caret = document.getElementById('sort-caret');
    function open() { menu.classList.remove('hidden'); btn.setAttribute('aria-expanded', 'true'); if (caret) caret.style.transform = 'rotate(180deg)'; }
    function close() { menu.classList.add('hidden'); btn.setAttribute('aria-expanded', 'false'); if (caret) caret.style.transform = ''; }
    btn.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.contains('hidden') ? open() : close(); });
    document.addEventListener('click', function (e) { if (!dd.contains(e.target)) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
}());

// Filters drawer — slide-over open/close (backdrop, X, Esc), body scroll lock.
(function () {
    var drawer = document.getElementById('filter-drawer');
    if (!drawer) return;
    var panel = document.getElementById('filter-panel');
    var backdrop = document.getElementById('filter-backdrop');
    var openBtn = document.getElementById('filter-open');
    var closeBtn = document.getElementById('filter-close');

    function open() {
        drawer.classList.remove('hidden');
        // next frame so the transition runs from the off-screen state
        requestAnimationFrame(function () {
            panel.classList.remove('translate-x-full');
            backdrop.classList.remove('opacity-0');
        });
        document.body.style.overflow = 'hidden';
    }
    function close() {
        panel.classList.add('translate-x-full');
        backdrop.classList.add('opacity-0');
        document.body.style.overflow = '';
        setTimeout(function () { drawer.classList.add('hidden'); }, 300);
    }
    openBtn && openBtn.addEventListener('click', open);
    closeBtn && closeBtn.addEventListener('click', close);
    backdrop && backdrop.addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !drawer.classList.contains('hidden')) close(); });
}());

// Product detail slide-over — clicking a product card slides the detail page in from the right
// over the dimmed listing (progressive enhancement; a direct visit / refresh loads the full page).
(function () {
    var grid    = document.getElementById('product-grid');
    var overlay = document.getElementById('pdp-overlay');
    if (!grid || !overlay) return;
    var scrim   = document.getElementById('pdp-scrim');
    var panel   = document.getElementById('pdp-panel');
    var content = document.getElementById('pdp-content');
    var loading = document.getElementById('pdp-loading');
    var root    = document.getElementById('listing-root');
    var NONCE   = '@Context.Items["csp-nonce"]';
    var open    = false;

    // Only bare "/products/<slug>" links are detail pages (not the grid or ?query listing links).
    function isDetailHref(href) { return /^\/products\/[^\/?#]+$/.test(href); }

    // The detail page's inline scripts are blocked by the strict CSP once injected via innerHTML.
    // Re-create them with THIS page's valid nonce so the browser will run them. External + JSON-LD
    // scripts are skipped (app.js is already loaded; structured data isn't executable).
    function runScripts(doc) {
        doc.querySelectorAll('script').forEach(function (s) {
            if (s.src) return;
            if ((s.type || '').indexOf('ld+json') !== -1) return;
            var el = document.createElement('script');
            el.nonce = NONCE;
            el.textContent = s.textContent;
            document.body.appendChild(el);
            el.remove();
        });
    }

    function wireInternalLinks() {
        // Back arrow (‹) closes the panel instead of navigating to the category.
        var back = content.querySelector('a[aria-label^="Back to"]');
        if (back) back.addEventListener('click', function (e) { e.preventDefault(); history.back(); });
        // Related-product links swap the panel in place (one history entry via replaceState).
        content.querySelectorAll('a[href^="/products/"]').forEach(function (a) {
            if (a === back) return;
            var href = a.getAttribute('href');
            if (!isDetailHref(href)) return;
            a.addEventListener('click', function (e) {
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
                e.preventDefault();
                history.replaceState({ pdp: 1 }, '', href);
                loadPanel(href);
                panel.scrollTop = 0;
            });
        });
    }

    function loadPanel(href) {
        loading.classList.remove('hidden');
        content.innerHTML = '';
        fetch(href, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
            .then(function (r) { return r.text(); })
            .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var main = doc.querySelector('main');
                content.innerHTML = main ? main.innerHTML : '';
                if (doc.title) document.title = doc.title;
                runScripts(doc);
                wireInternalLinks();
                loading.classList.add('hidden');
            })
            .catch(function () { window.location.href = href; });   // fall back to a real navigation
    }

    var waFloat = document.getElementById('wa-float');
    function show() {
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        if (waFloat) waFloat.style.display = 'none';   // keep the FAB off the panel's buy bar
        requestAnimationFrame(function () {
            panel.classList.remove('translate-x-full');
            scrim.classList.remove('opacity-0');
            if (root) root.classList.add('pdp-dimmed');
        });
        open = true;
    }
    function hide() {
        panel.classList.add('translate-x-full');
        scrim.classList.add('opacity-0');
        if (root) root.classList.remove('pdp-dimmed');
        document.body.style.overflow = '';
        if (waFloat) waFloat.style.display = '';
        open = false;
        setTimeout(function () { overlay.classList.add('hidden'); content.innerHTML = ''; }, 300);
    }

    grid.addEventListener('click', function (e) {
        var a = e.target.closest('a[href^="/products/"]');
        if (!a || !grid.contains(a)) return;
        var href = a.getAttribute('href');
        if (!isDetailHref(href)) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;   // keep new-tab working
        e.preventDefault();
        history.pushState({ pdp: 1 }, '', href);
        panel.scrollTop = 0;
        show();
        loadPanel(href);
    });

    scrim.addEventListener('click', function () { history.back(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) history.back(); });

    window.addEventListener('popstate', function (e) {
        var st = e.state;
        if (st && st.pdp) {           // forward into an overlay state
            if (!open) show();
            panel.scrollTop = 0;
            loadPanel(location.pathname);
        } else if (open) {            // back out of the overlay
            hide();
        }
    });
}());
</script>
}
