@using SterlingLams.Web.Services
@inject ISettingsService SettingsService
@{
    ViewData["Title"] = "Luxury Jewellery";
    ViewData["Description"] = "Zephiel is an online jewelry store offering elegant earrings, necklaces, bracelets, rings, and accessories with secure shopping and nationwide delivery.";
    var siteName = await SettingsService.GetAsync("general.site_name", "Zephiel");
    Layout = "_Layout";
    // The page ends on the dark editorial newsletter band — sit the footer flush against it.
    ViewData["FooterFlush"] = true;

    var featuredProducts = ViewBag.FeaturedProducts as List<SterlingLams.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var bestSellers      = ViewBag.BestSellers    as List<SterlingLams.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var trending         = ViewBag.Trending       as List<SterlingLams.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var recentlyViewed   = ViewBag.RecentlyViewed as List<SterlingLams.Web.Models.ViewModels.ProductCardViewModel> ?? new();

    // ─── Hero (admin-editable in Settings → Homepage) ────────────────────────
    var heroImageUrl  = await SettingsService.GetAsync("homepage.hero_image_url", "");
    var heroImagesRaw = await SettingsService.GetAsync("homepage.hero_images", "");
    var heroEyebrow   = await SettingsService.GetAsync("homepage.hero_eyebrow",  "New Season 2025");
    var heroHeadline  = await SettingsService.GetAsync("homepage.hero_headline", "Effortless Glamour");
    var heroSubtext   = await SettingsService.GetAsync("homepage.hero_subtext",  "Jewellery made to be noticed — new-season pieces for the woman who shines.");
    var heroCta       = await SettingsService.GetAsync("homepage.hero_cta",      "Shop Collection");
    var heroImages    = heroImagesRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(u => u.Trim()).Where(u => u.Length > 0).ToList();
    if (heroImages.Count == 0 && !string.IsNullOrWhiteSpace(heroImageUrl)) heroImages.Add(heroImageUrl);
    var heroImage    = heroImages.FirstOrDefault();
    var hasHeroImage = heroImage != null;

    var showFeatured     = await SettingsService.GetBoolAsync("homepage.show_featured", true);
    var showBestSellers  = await SettingsService.GetBoolAsync("homepage.show_best_sellers", true);
    var showTrending     = await SettingsService.GetBoolAsync("homepage.show_trending", true);
    var showRecentlyView = await SettingsService.GetBoolAsync("homepage.show_recently_viewed", true);
    var featuredHeading  = await SettingsService.GetAsync("homepage.featured_heading", "Featured Pieces");
    var featuredSlideMs  = Math.Max(2, await SettingsService.GetIntAsync("homepage.featured_slide_seconds", 3)) * 1000;

    // Low-stock threshold shared by every product card on the page.
    ViewData["CardLowThreshold"] = await SettingsService.GetBoolAsync("inventory.show_low_stock_nudge", true)
        ? (int)await SettingsService.GetDecimalAsync("inventory.low_stock_threshold", 5)
        : 0;

    // Trust labels power the oversized editorial ticker (Settings → Homepage, items 1–6).
    var tickerLabels = new[]
    {
        await SettingsService.GetAsync("homepage.trust_1", "Certified Authentic"),
        await SettingsService.GetAsync("homepage.trust_2", "Secure Checkout"),
        await SettingsService.GetAsync("homepage.trust_3", "Easy Returns"),
        await SettingsService.GetAsync("homepage.trust_4", ""),
        await SettingsService.GetAsync("homepage.trust_5", ""),
        await SettingsService.GetAsync("homepage.trust_6", "")
    }.Where(l => !string.IsNullOrWhiteSpace(l)).Select(l => l.Trim()).ToList();
    if (tickerLabels.Count == 0) tickerLabels.Add("Fine Jewellery");

    var shopCategories = ViewBag.ShopCategories as List<SterlingLams.Web.Models.Domain.Category> ?? new();
}

<partial name="_QuickViewModal" />

<!-- ═══ Hero — asymmetric editorial split ═══════════════════════════════════ -->
<section class="relative bg-neutral-950 text-white overflow-hidden">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] min-h-[92vh] lg:min-h-screen">

        <!-- Editorial column -->
        <div class="relative z-10 flex flex-col justify-between px-6 sm:px-10 lg:px-16 pt-10 pb-14 lg:py-20 order-2 lg:order-1">
            <!-- Masthead line -->
            <div class="hidden lg:flex items-center gap-4 text-[10px] tracking-[0.4em] uppercase text-white/50">
                <span>Volume 01</span>
                <span class="flex-1 h-px bg-white/20"></span>
                <span>@siteName</span>
            </div>

            <!-- Display headline -->
            <div class="py-12 lg:py-0">
                <p class="text-[11px] tracking-[0.45em] uppercase text-brand-300 mb-6">@heroEyebrow</p>
                <h1 class="font-bodoni font-light leading-[0.92] tracking-tight text-6xl sm:text-7xl lg:text-8xl xl:text-[8.5rem]">
                    @{
                        var words = heroHeadline.Split(' ');
                        var lead  = words.Length > 1 ? string.Join(' ', words.Take(words.Length - 1)) : heroHeadline;
                        var tail  = words.Length > 1 ? words.Last() : "";
                    }
                    <span class="block">@lead</span>
                    @if (!string.IsNullOrEmpty(tail))
                    {
                        <span class="block italic text-brand-300">@tail</span>
                    }
                </h1>
                <p class="mt-8 max-w-md text-sm sm:text-base font-light leading-relaxed text-white/60">
                    @heroSubtext
                </p>
                <div class="mt-10 flex flex-col sm:flex-row gap-4">
                    <a asp-controller="Products" asp-action="Index"
                       class="group inline-flex items-center justify-center gap-3 bg-brand-500 text-white text-[11px] tracking-[0.25em] uppercase px-9 py-4 hover:bg-brand-400 transition-colors duration-300">
                        @heroCta
                        <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                    </a>
                    <a asp-controller="Home" asp-action="Collections"
                       class="inline-flex items-center justify-center border border-white/25 text-white text-[11px] tracking-[0.25em] uppercase px-9 py-4 hover:border-white hover:bg-white hover:text-neutral-950 transition-colors duration-300">
                        Explore Lookbook
                    </a>
                </div>
            </div>

            <!-- Footline / scroll cue -->
            <div class="flex items-center justify-between text-[10px] tracking-[0.35em] uppercase text-white/40">
                <span>Est. @siteName — Fine Jewellery</span>
                <span class="hidden sm:flex items-center gap-3">
                    Scroll
                    <span class="w-10 h-px bg-white/30"></span>
                </span>
            </div>
        </div>

        <!-- Image column -->
        <div class="relative order-1 lg:order-2 min-h-[52vh] lg:min-h-0 overflow-hidden">
            @if (hasHeroImage)
            {
                <img src="@Img.Cld(heroImage, 1400)" alt="@(siteName) campaign" decoding="async"
                     loading="eager" fetchpriority="high"
                     class="absolute inset-0 w-full h-full object-cover object-center" />
                <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/50 via-transparent to-transparent lg:bg-gradient-to-r lg:from-neutral-950/60 lg:via-neutral-950/5 lg:to-transparent"></div>
            }
            else
            {
                <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-neutral-900 to-neutral-950"></div>
            }
            <!-- Oversized index number -->
            <span class="pointer-events-none absolute bottom-6 right-6 lg:bottom-10 lg:right-10 font-bodoni text-7xl lg:text-9xl leading-none text-white/15 select-none"
                  style="-webkit-text-stroke:1px rgba(255,255,255,.35);color:transparent;">01</span>
            <!-- Vertical label -->
            <span class="hidden lg:block absolute top-1/2 -translate-y-1/2 left-6 text-[10px] tracking-[0.5em] uppercase text-white/50"
                  style="writing-mode:vertical-rl;">The New Collection</span>
        </div>
    </div>
</section>

<!-- ═══ Oversized running statement (editorial ticker) ══════════════════════ -->
<section class="bg-neutral-950 text-white border-t border-white/10 overflow-hidden py-6 lg:py-8" aria-label="Why shop with us">
    <div class="ed-marquee flex w-max items-center">
        @for (var g = 0; g < 2; g++)
        {
            <div class="flex shrink-0 items-center" aria-hidden="@(g == 1 ? "true" : "false")">
                @for (var r = 0; r < 4; r++)
                {
                    @foreach (var label in tickerLabels)
                    {
                        <span class="font-bodoni italic font-light text-3xl lg:text-5xl whitespace-nowrap px-8 text-white/85">@label</span>
                        <span class="text-brand-400 text-2xl lg:text-3xl px-2">&#10022;</span>
                    }
                }
            </div>
        }
    </div>
</section>
<style>
    @@keyframes edScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .ed-marquee { animation: edScroll 60s linear infinite; will-change: transform; }
    .ed-marquee:hover { animation-play-state: paused; }
    @@media (prefers-reduced-motion: reduce) { .ed-marquee { animation: none; } }
</style>

<!-- ═══ Category index — numbered magazine list w/ hover preview ════════════ -->
@if (shopCategories.Any())
{
    <section class="bg-canvas py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
            <div class="flex items-end justify-between mb-12 lg:mb-16">
                <div>
                    <p class="text-[11px] tracking-[0.4em] uppercase text-brand-500 mb-3">The Index</p>
                    <h2 class="font-bodoni text-5xl lg:text-7xl font-light text-neutral-900 leading-none">Shop by Category</h2>
                </div>
                <a asp-controller="Products" asp-action="Index"
                   class="hidden md:inline-block text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-600 transition-colors border-b border-neutral-300 pb-1">
                    View All &rarr;
                </a>
            </div>

            <div class="grid lg:grid-cols-[1fr_26rem] gap-10 lg:gap-16 items-start">
                <!-- Numbered list -->
                <ul id="cat-index" class="border-t border-neutral-900/15">
                    @{ var ci = 0; }
                    @foreach (var cat in shopCategories)
                    {
                        ci++;
                        var catImg = string.IsNullOrWhiteSpace(cat.ImageUrl) ? "" : Img.Cld(cat.ImageUrl, 800, 1000);
                        <li>
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug"
                               class="cat-row group flex items-baseline justify-between gap-6 border-b border-neutral-900/15 py-5 lg:py-7"
                               data-cat-img="@catImg" data-cat-name="@cat.Name">
                                <span class="flex items-baseline gap-5 lg:gap-8 min-w-0">
                                    <span class="font-bodoni text-base lg:text-lg text-neutral-400 tabular-nums">@ci.ToString("00")</span>
                                    <span class="font-bodoni text-3xl sm:text-4xl lg:text-6xl font-light text-neutral-900 group-hover:text-brand-600 transition-colors truncate">@cat.Name</span>
                                </span>
                                <span class="text-neutral-300 group-hover:text-brand-500 group-hover:translate-x-1 transition-all text-xl lg:text-2xl shrink-0">&#8599;</span>
                            </a>
                        </li>
                    }
                </ul>

                <!-- Hover preview (desktop) -->
                <div class="hidden lg:block sticky top-28">
                    <div class="relative aspect-[4/5] overflow-hidden bg-neutral-200">
                        <img id="cat-preview-img" src="" alt="" class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 opacity-0" />
                        <div id="cat-preview-fallback" class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-brand-100 via-neutral-100 to-stone-100">
                            <span id="cat-preview-name" class="font-bodoni text-3xl font-light text-neutral-400 text-center px-6"></span>
                        </div>
                        <span class="absolute bottom-4 left-4 text-[10px] tracking-[0.3em] uppercase text-white/90 mix-blend-difference">Preview</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- ═══ The Edit — asymmetric feature spread (admin-editable) ═══════════════ -->
@{
    var featOn      = await SettingsService.GetBoolAsync("home.feature.enabled", true);
    var featHeading = await SettingsService.GetAsync("home.feature.heading", "The Edit");
    var featBlocks  = new List<(string Image, string Title, string Text, string Category, string LinkText)>();
    foreach (var b in new[] { "b1", "b2" })
    {
        var img = await SettingsService.GetAsync($"home.feature.{b}.image", "");
        if (string.IsNullOrWhiteSpace(img)) continue;
        featBlocks.Add((
            img,
            await SettingsService.GetAsync($"home.feature.{b}.title", ""),
            await SettingsService.GetAsync($"home.feature.{b}.text", ""),
            await SettingsService.GetAsync($"home.feature.{b}.category", ""),
            await SettingsService.GetAsync($"home.feature.{b}.link_text", "Shop the Collection")
        ));
    }
}
@if (featOn && featBlocks.Any())
{
    <section class="bg-neutral-950 text-white py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
            @if (!string.IsNullOrWhiteSpace(featHeading))
            {
                <div class="flex items-center gap-6 mb-14">
                    <h2 class="font-bodoni text-5xl lg:text-7xl font-light leading-none">@featHeading</h2>
                    <span class="flex-1 h-px bg-white/15"></span>
                    <span class="text-[11px] tracking-[0.35em] uppercase text-white/40">Featured</span>
                </div>
            }
            <div class="grid gap-10 lg:gap-16 @(featBlocks.Count > 1 ? "lg:grid-cols-2" : "max-w-2xl")">
                @{ var fi = 0; }
                @foreach (var blk in featBlocks)
                {
                    fi++;
                    // Stagger the two blocks vertically for an editorial off-grid rhythm.
                    var offset = (featBlocks.Count > 1 && fi == 2) ? "lg:mt-24" : "";
                    <article class="@offset">
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="group block relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[900ms]" />
                                <span class="absolute top-5 left-5 font-bodoni text-5xl text-white/70"
                                      style="-webkit-text-stroke:1px rgba(255,255,255,.5);color:transparent;">@fi.ToString("00")</span>
                            </a>
                        }
                        else
                        {
                            <div class="relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Title))
                        {
                            <h3 class="font-bodoni text-3xl lg:text-4xl font-light mb-3">@blk.Title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Text))
                        {
                            <p class="text-sm text-white/55 font-light max-w-md mb-5 leading-relaxed">@blk.Text</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="inline-block text-[11px] tracking-[0.25em] uppercase text-white border-b-2 border-brand-500 pb-1 hover:text-brand-300 transition-colors">
                                @(string.IsNullOrWhiteSpace(blk.LinkText) ? "Shop the Collection" : blk.LinkText)
                            </a>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

<!-- ═══ The Selection — featured products ═══════════════════════════════════ -->
@if (showFeatured)
{
    <section class="bg-canvas py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
            <div class="flex items-end justify-between mb-12 lg:mb-16">
                <div>
                    <p class="text-[11px] tracking-[0.4em] uppercase text-brand-500 mb-3">Curated for you</p>
                    <h2 class="font-bodoni text-5xl lg:text-7xl font-light text-neutral-900 leading-none">@featuredHeading</h2>
                </div>
                <a asp-controller="Products" asp-action="Index"
                   class="hidden md:inline-block text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-600 transition-colors border-b border-neutral-300 pb-1">
                    View All &rarr;
                </a>
            </div>

            @if (featuredProducts.Any())
            {
                <div class="relative group/carousel">
                    @if (featuredProducts.Count > 4)
                    {
                        <button type="button" id="feat-prev" aria-label="Previous"
                                class="hidden md:flex absolute -left-5 top-[30%] -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white shadow-md border border-neutral-200 text-neutral-700 hover:bg-brand-500 hover:text-white hover:border-brand-500 items-center justify-center transition-colors">&lsaquo;</button>
                        <button type="button" id="feat-next" aria-label="Next"
                                class="hidden md:flex absolute -right-5 top-[30%] -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white shadow-md border border-neutral-200 text-neutral-700 hover:bg-brand-500 hover:text-white hover:border-brand-500 items-center justify-center transition-colors">&rsaquo;</button>
                    }
                    <div id="feat-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;">
                        @foreach (var p in featuredProducts)
                        {
                            <div class="snap-start shrink-0 w-[calc(50%-12px)] md:w-[calc(25%-18px)]">
                                <partial name="_ProductCard" model="p" />
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="group">
                            <div class="aspect-square bg-neutral-100 mb-4 overflow-hidden">
                                <div class="w-full h-full bg-gradient-to-br from-neutral-200 to-neutral-100"></div>
                            </div>
                            <div class="h-3 bg-neutral-200 rounded w-3/4 mb-2"></div>
                            <div class="h-2 bg-neutral-100 rounded w-1/3"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ═══ Merchandising rows ══════════════════════════════════════════════════ -->
@if (showBestSellers)
{
    @await Html.PartialAsync("_ProductCardRow", bestSellers, new ViewDataDictionary(ViewData)
    {
        ["RowTitle"] = "Best Sellers", ["RowEyebrow"] = "Most loved", ["RowBg"] = "bg-white",
    })
}
@if (showTrending)
{
    @await Html.PartialAsync("_ProductCardRow", trending, new ViewDataDictionary(ViewData)
    {
        ["RowTitle"] = "Trending Now", ["RowEyebrow"] = "Popular this month", ["RowBg"] = "bg-stone-50",
    })
}
@if (showRecentlyView)
{
    @await Html.PartialAsync("_ProductCardRow", recentlyViewed, new ViewDataDictionary(ViewData)
    {
        ["RowTitle"] = "Recently Viewed", ["RowEyebrow"] = "Pick up where you left off", ["RowBg"] = "bg-white",
    })
}

<!-- ═══ Newsletter — full-bleed editorial statement ═════════════════════════ -->
<section class="relative bg-neutral-950 text-white overflow-hidden" aria-label="Newsletter signup">
    <span class="pointer-events-none absolute -top-10 -right-6 lg:right-10 font-bodoni italic text-[9rem] lg:text-[16rem] leading-none text-white/5 select-none">&#10022;</span>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-16 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 items-center">
        <div>
            <p class="text-[11px] tracking-[0.4em] uppercase text-brand-300 mb-5">Enjoy amazing discounts</p>
            <h2 class="font-bodoni text-5xl lg:text-7xl font-light leading-[0.95]">
                Join the <span class="italic text-brand-300">List</span>
            </h2>
            <p class="mt-6 max-w-md text-sm text-white/55 font-light leading-relaxed">
                Be first to see new arrivals, private previews and members-only offers.
            </p>
        </div>
        <form id="newsletter-form" class="w-full">
            <div class="flex flex-col sm:flex-row gap-3 max-w-lg lg:ml-auto">
                <input id="newsletter-email" name="email" type="email" required placeholder="Your email address" aria-label="Email address"
                       class="flex-1 bg-transparent border-b border-white/30 text-white placeholder-white/40 px-1 py-3 text-sm focus:outline-none focus:border-brand-400 transition-colors" />
                <button type="submit"
                        class="shrink-0 bg-white text-neutral-950 text-[11px] tracking-[0.25em] uppercase px-9 py-3.5 hover:bg-brand-500 hover:text-white transition-colors duration-300 disabled:opacity-60">
                    Sign Up
                </button>
            </div>
            <p id="newsletter-msg" class="text-sm mt-4 min-h-[1.25rem] max-w-lg lg:ml-auto"></p>
        </form>
    </div>
</section>

@section Scripts {
<script nonce="@Context.Items["csp-nonce"]">
// Newsletter signup
(function () {
    const form = document.getElementById('newsletter-form');
    if (!form) return;
    const msg = document.getElementById('newsletter-msg');
    const btn = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('newsletter-email').value.trim();
        btn.disabled = true; msg.textContent = ''; msg.className = 'text-sm mt-4 min-h-[1.25rem] max-w-lg lg:ml-auto text-white/70';
        try {
            const res = await fetch('/Home/Subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(email)
            });
            const data = await res.json();
            msg.textContent = data.message;
            msg.classList.add(data.success ? 'text-emerald-400' : 'text-red-400');
            if (data.success) form.reset();
        } catch {
            msg.textContent = 'Something went wrong. Please try again.';
            msg.classList.add('text-red-400');
        } finally { btn.disabled = false; }
    });
}());

// Category index — hover reveals the category image in the preview panel.
(function () {
    var list = document.getElementById('cat-index');
    var img  = document.getElementById('cat-preview-img');
    var fb   = document.getElementById('cat-preview-fallback');
    var name = document.getElementById('cat-preview-name');
    if (!list || !img) return;
    var rows = list.querySelectorAll('.cat-row');
    function preview(row) {
        var src = row.getAttribute('data-cat-img');
        name.textContent = row.getAttribute('data-cat-name') || '';
        if (src) {
            img.src = src; img.alt = row.getAttribute('data-cat-name') || '';
            img.classList.remove('opacity-0'); fb.classList.add('opacity-0');
        } else {
            img.classList.add('opacity-0'); fb.classList.remove('opacity-0');
        }
    }
    rows.forEach(function (r) { r.addEventListener('mouseenter', function () { preview(r); }); });
    if (rows.length) preview(rows[0]);   // default to the first category
}());

// Featured products carousel — auto-advances one card at a time, loops, pauses on interaction.
(function () {
    var track = document.getElementById('feat-track');
    if (!track) return;
    function page() { return Math.max(track.clientWidth * 0.9, 240); }
    function card() { var c = track.firstElementChild; return c ? c.getBoundingClientRect().width + 24 : page(); }
    function atEnd() { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 8; }

    var next = document.getElementById('feat-next'), prev = document.getElementById('feat-prev');
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: page(), behavior: 'smooth' }); restart(); });
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -page(), behavior: 'smooth' }); restart(); });

    var timer;
    function advance() {
        if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: card(), behavior: 'smooth' });
    }
    function start() { if (track.scrollWidth > track.clientWidth + 8) timer = setInterval(advance, @featuredSlideMs); }
    function stop() { clearInterval(timer); }
    function restart() { stop(); start(); }

    track.addEventListener('mouseenter', stop);
    track.addEventListener('mouseleave', start);
    track.addEventListener('touchstart', stop, { passive: true });
    track.addEventListener('touchend', function () { setTimeout(start, 4000); }, { passive: true });
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
    start();
}());
</script>
}
