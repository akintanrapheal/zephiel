@using Zephiel.Web.Services
@inject ISettingsService SettingsService
@{
    var tagline  = await SettingsService.GetAsync("general.tagline", "Timeless luxury jewellery crafted with the finest materials.");
    var logoUrl  = await SettingsService.GetAsync("general.logo_url");
    var siteName = await SettingsService.GetAsync("general.site_name", "Zephiel");

    // Pages that end on a dark full-bleed section (e.g. Home's newsletter) set FooterFlush
    // so the footer butts straight against it — no cream body-gap above the footer.
    var footerTopMargin = ViewData["FooterFlush"] as bool? == true ? "" : "mt-24";
}

<footer class="bg-brand-50 text-neutral-800 @footerTopMargin">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">

        <!-- Top row: brand (top-left logo only) + link columns -->
        <div class="grid gap-12 lg:gap-20 md:grid-cols-[1.1fr_2fr]">

            <!-- Brand -->
            <div>
                <a asp-controller="Home" asp-action="Index" class="inline-block">
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@logoUrl" alt="@siteName" class="h-20 w-auto" />
                    }
                    else
                    {
                        <span class="font-bodoni text-3xl font-light tracking-[0.25em] uppercase text-neutral-900">@siteName</span>
                    }
                </a>
                <p class="mt-5 max-w-xs text-sm leading-relaxed font-light text-neutral-500">@tagline</p>
                <p class="mt-6 text-[11px] tracking-[0.3em] uppercase text-neutral-400">Nationwide delivery across Nigeria</p>
            </div>

            <!-- Link columns -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 lg:gap-10">
                <div>
                    <h4 class="font-bodoni text-lg font-light text-neutral-900 mb-4">Shop</h4>
                    <ul class="space-y-2.5">
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="rings"     class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Rings</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="necklaces" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Necklaces</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="bracelets" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Bracelets</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-category="earrings"  class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Earrings</a></li>
                        <li><a asp-controller="Products" asp-action="Index" asp-route-isNewArrival="true"  class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">New Arrivals</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bodoni text-lg font-light text-neutral-900 mb-4">Company</h4>
                    <ul class="space-y-2.5">
                        <li><a asp-controller="Home"     asp-action="About"   class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Our Story</a></li>
                        <li><a asp-controller="Journal"  asp-action="Index"   class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Journal</a></li>
                        <li><a asp-controller="Referral" asp-action="Index"   class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Refer a Friend</a></li>
                        <li><a asp-controller="Home"     asp-action="Contact" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Contact</a></li>
                        <li><a href="/track" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Track Order</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-bodoni text-lg font-light text-neutral-900 mb-4">Customer Care</h4>
                    <ul class="space-y-2.5">
                        <li><a asp-controller="Home" asp-action="Contact" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Contact us</a></li>
                        <li><a href="/track" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Track your order</a></li>
                        <li><a asp-controller="Home" asp-action="PaymentReturns" class="text-sm text-neutral-600 hover:text-brand-600 transition-colors">Payment &amp; Returns</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Bottom bar: payments + legal + copyright -->
        <div class="mt-14 lg:mt-16 pt-8 border-t border-neutral-900/10">
            <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
                <div class="flex justify-center md:justify-start">
                    <partial name="_PaymentBadges" />
                </div>
                <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
                    <a asp-controller="Home" asp-action="Privacy" class="text-xs tracking-wide text-neutral-500 hover:text-brand-600 transition-colors">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="Terms"   class="text-xs tracking-wide text-neutral-500 hover:text-brand-600 transition-colors">Terms of Service</a>
                    <a asp-controller="Home" asp-action="PaymentReturns" class="text-xs tracking-wide text-neutral-500 hover:text-brand-600 transition-colors">Payment &amp; Returns</a>
                </div>
            </div>
            <p class="mt-6 text-center md:text-left text-xs text-neutral-400">&copy; @DateTime.UtcNow.Year @siteName. All rights reserved.</p>
        </div>
    </div>
</footer>
