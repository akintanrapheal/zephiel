@model Zephiel.Web.Models.ViewModels.ProductCardViewModel
@*
    Listing-page product card — clean "catalogue" presentation (large image tile on a light
    ground, centred serif name + price, CTA revealed on hover). Reuses the shared badge / hover-
    action / CTA sub-partials so add-to-cart, quick-view and wishlist behave exactly like the
    standard _ProductCard. Used by _ProductCards (first paint + "View more").

    Callers set ViewData["CardLowThreshold"] once (0 = off) so the "Only N left" badge doesn't
    re-read settings per card.
*@
@{
    var cardLowThreshold = ViewData["CardLowThreshold"] as int? ?? 0;
}
<div class="group flex flex-col text-center">
    <!-- Image tile -->
    <a asp-controller="Products" asp-action="Detail" asp-route-slug="@Model.Slug"
       class="block aspect-square bg-neutral-50 overflow-hidden relative mb-5">
        <img src="@Img.Cld(Model.PrimaryImageUrl, 700, 700)" alt="@Model.Name"
             loading="lazy" width="700" height="700"
             class="w-full h-full object-cover transition-all duration-700 group-hover:scale-[1.03] @(Model.SecondaryImageUrl != null ? "group-hover:opacity-0" : "")" />
        @if (Model.SecondaryImageUrl != null)
        {
            <img src="@Img.Cld(Model.SecondaryImageUrl, 700, 700)" alt="@Model.Name" loading="lazy" width="700" height="700"
                 class="absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-700 group-hover:opacity-100 group-hover:scale-[1.03]" />
        }

        <partial name="_DiscountBadge" model="Model.DiscountPercent" />
        @if (Model.IsNewArrival)
        {
            <span class="absolute top-4 left-4 bg-neutral-900/90 text-white text-[10px] tracking-[0.15em] uppercase px-2.5 py-1">New</span>
        }
        @if (!Model.IsAvailable)
        {
            <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] flex items-center justify-center">
                <span class="text-[11px] tracking-[0.2em] uppercase text-neutral-600 border border-neutral-300 px-3 py-1.5 bg-white/80">Sold Out</span>
            </div>
        }
        else if (cardLowThreshold > 0 && Model.TotalStock > 0 && Model.TotalStock <= cardLowThreshold)
        {
            <span class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 bg-white/90 backdrop-blur text-amber-700 text-[10px] tracking-wide uppercase px-2.5 py-1 rounded-full shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                Only @Model.TotalStock left
            </span>
        }

        <!-- Quick actions on hover: Compare / Quick View / Wishlist -->
        <partial name="_ProductHoverActions" model="Model" />

        <partial name="_Watermark" />
    </a>

    <!-- Info -->
    <a asp-controller="Products" asp-action="Detail" asp-route-slug="@Model.Slug" class="block flex-grow">
        <h3 class="font-bodoni text-lg md:text-xl font-normal text-neutral-900 leading-snug mb-1.5 px-2">
            @Model.Name
        </h3>
        @if (Model.ReviewCount > 0)
        {
            <p class="flex items-center justify-center gap-1 mb-1.5 text-xs leading-none">
                <span>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= Math.Round(Model.AverageRating) ? "text-brand-500" : "text-neutral-300")">★</span>
                    }
                </span>
                <span class="text-neutral-400">(@Model.ReviewCount)</span>
            </p>
        }
        @if (Model.IsOnSale)
        {
            <p class="text-sm"><span class="text-neutral-400 line-through">@Model.FormattedRegularPrice</span> <span class="text-brand-600 font-medium ml-1">@Model.FormattedPrice</span></p>
        }
        else
        {
            <p class="text-sm text-neutral-600 tracking-wide">@Model.FormattedPrice</p>
        }
    </a>

    <!-- CTA — quiet until hover on desktop; always shown on touch/small screens -->
    <div class="md:opacity-0 md:group-hover:opacity-100 md:focus-within:opacity-100 md:transition-opacity md:duration-300">
        <partial name="_ProductCardCta" model="Model" />
    </div>
</div>
