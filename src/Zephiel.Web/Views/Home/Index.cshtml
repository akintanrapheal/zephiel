@using Zephiel.Web.Services
@inject ISettingsService SettingsService
@{
    ViewData["Title"] = "Luxury Jewellery";
    ViewData["Description"] = "Zephiel is an online jewelry store offering elegant earrings, necklaces, bracelets, rings, and accessories with secure shopping and nationwide delivery.";
    var siteName = await SettingsService.GetAsync("general.site_name", "Zephiel");
    Layout = "_Layout";
    // The page ends on the dark editorial newsletter band — sit the footer flush against it.
    ViewData["FooterFlush"] = true;

    var featuredProducts = ViewBag.FeaturedProducts as List<Zephiel.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var bestSellers      = ViewBag.BestSellers    as List<Zephiel.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var trending         = ViewBag.Trending       as List<Zephiel.Web.Models.ViewModels.ProductCardViewModel> ?? new();
    var recentlyViewed   = ViewBag.RecentlyViewed as List<Zephiel.Web.Models.ViewModels.ProductCardViewModel> ?? new();

    // ─── Hero (admin-editable in Settings → Homepage) ────────────────────────
    var heroImageUrl  = await SettingsService.GetAsync("homepage.hero_image_url", "");
    var heroImagesRaw = await SettingsService.GetAsync("homepage.hero_images", "");
    var heroEyebrow   = await SettingsService.GetAsync("homepage.hero_eyebrow",  "New Season 2025");
    var heroHeadline  = await SettingsService.GetAsync("homepage.hero_headline", "Effortless Glamour");
    var heroSubtext   = await SettingsService.GetAsync("homepage.hero_subtext",  "Jewellery made to be noticed — new-season pieces for the woman who shines.");
    var heroCta       = await SettingsService.GetAsync("homepage.hero_cta",      "Shop Collection");
    var heroImages    = heroImagesRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(u => u.Trim()).Where(u => u.Length > 0).ToList();
    if (heroImages.Count == 0 && !string.IsNullOrWhiteSpace(heroImageUrl)) heroImages.Add(heroImageUrl);
    var heroImage    = heroImages.FirstOrDefault();
    var hasHeroImage = heroImage != null;

    var showFeatured     = await SettingsService.GetBoolAsync("homepage.show_featured", true);
    var showBestSellers  = await SettingsService.GetBoolAsync("homepage.show_best_sellers", true);
    var showTrending     = await SettingsService.GetBoolAsync("homepage.show_trending", true);
    var showRecentlyView = await SettingsService.GetBoolAsync("homepage.show_recently_viewed", true);
    var featuredHeading  = await SettingsService.GetAsync("homepage.featured_heading", "Featured Pieces");
    var featuredSlideMs  = Math.Max(2, await SettingsService.GetIntAsync("homepage.featured_slide_seconds", 3)) * 1000;

    // Low-stock threshold shared by every product card on the page.
    ViewData["CardLowThreshold"] = await SettingsService.GetBoolAsync("inventory.show_low_stock_nudge", true)
        ? (int)await SettingsService.GetDecimalAsync("inventory.low_stock_threshold", 5)
        : 0;

    // Trust labels power the oversized editorial ticker (Settings → Homepage, items 1–6).
    var tickerLabels = new[]
    {
        await SettingsService.GetAsync("homepage.trust_1", "Certified Authentic"),
        await SettingsService.GetAsync("homepage.trust_2", "Secure Checkout"),
        await SettingsService.GetAsync("homepage.trust_3", "Easy Returns"),
        await SettingsService.GetAsync("homepage.trust_4", ""),
        await SettingsService.GetAsync("homepage.trust_5", ""),
        await SettingsService.GetAsync("homepage.trust_6", "")
    }.Where(l => !string.IsNullOrWhiteSpace(l)).Select(l => l.Trim()).ToList();
    if (tickerLabels.Count == 0) tickerLabels.Add("Fine Jewellery");

    var shopCategories = ViewBag.ShopCategories as List<Zephiel.Web.Models.Domain.Category> ?? new();

    // ─── Homepage theme (Admin → Settings → Homepage → Homepage Theme) ───────
    var theme      = SettingsSelectOptions.Coerce("homepage.theme", await SettingsService.GetAsync("homepage.theme", "editorial"));
    var isMinimal  = theme == "minimal";
    var isBoutique = theme == "boutique";
    var isClassic  = theme == "classic";
    var lightHero  = isMinimal || isBoutique;

    // Classic-theme gold accents
    var goldText = "text-[#cbaa72]";
    var goldBtn  = "bg-[#b0895a] hover:bg-[#c19a63]";
    // Classic theme shows exactly four collection tiles (Rings/Necklaces/Earrings/Bracelets,
    // falling back to the first four) and a static trust bar.
    var classicCats = new[] { "rings", "necklaces", "earrings", "bracelets" }
        .Select(s => shopCategories.FirstOrDefault(c => c.Slug == s))
        .Where(c => c != null).Select(c => c!).ToList();
    if (classicCats.Count < 4) classicCats = shopCategories.Take(4).ToList();
    var classicTrust = tickerLabels.Take(4).ToList();
    // Trust-bar icons (shipping · shield · gem · lock), reused by every theme's static trust bar.
    var trustIcons = new[]
    {
        "M3 7.5h11v7H3zM14 10h3.5L20 12.5v2H14z M6.5 16.5a1.5 1.5 0 103 0 M15 16.5a1.5 1.5 0 103 0",
        "M12 3l7 3v5c0 4-3 6.7-7 8-4-1.3-7-4-7-8V6z",
        "M12 2.5l2.3 4.7 5.2.8-3.8 3.7.9 5.2L12 14.4l-4.6 2.4.9-5.2L4.5 8l5.2-.8z",
        "M6.5 10.5V8a5.5 5.5 0 1111 0v2.5 M5 10.5h14v9H5z"
    };
    var tTrustIcon = isMinimal ? "text-neutral-400" : "text-brand-400";

    // Shared tokens
    var tHead    = isMinimal ? "font-sans" : "font-bodoni";
    var tEyebrow = isMinimal ? "text-neutral-400" : isBoutique ? "text-brand-400" : "text-brand-500";
    var tCanvas  = isMinimal ? "bg-white" : isBoutique ? "bg-stone-50" : "bg-canvas";
    var tImgRad  = isBoutique ? "rounded-2xl" : "";
    var tBtn     = isMinimal ? "bg-neutral-900 hover:bg-neutral-800" : "bg-brand-500 hover:bg-brand-400";

    // Hero tokens
    var tHeroWrap  = isMinimal  ? "bg-white text-neutral-900"
                   : isBoutique ? "bg-gradient-to-br from-stone-100 via-stone-50 to-white text-neutral-900"
                   :              "bg-neutral-950 text-white";
    var tHeroMuted = lightHero ? "text-neutral-500" : "text-white/60";
    var tHeroFaint = lightHero ? "text-neutral-400" : "text-white/40";
    var tHeroLine  = lightHero ? "bg-neutral-300"   : "bg-white/20";
    var tHeroEye   = isMinimal ? "text-neutral-400" : isBoutique ? "text-brand-400" : "text-brand-300";
    var tHeroTail  = isMinimal ? "text-neutral-900" : "text-brand-300";
    var tHeroBtn2  = lightHero ? "border-neutral-300 text-neutral-900 hover:bg-neutral-900 hover:text-white"
                               : "border-white/25 text-white hover:bg-white hover:text-neutral-950";

    // Ticker tokens
    var tTicker      = isMinimal  ? "bg-neutral-50 text-neutral-800 border-neutral-200"
                     : isBoutique ? "bg-stone-100 text-neutral-800 border-stone-200"
                     :              "bg-neutral-950 text-white border-white/10";
    var tTickerLabel = isMinimal ? "font-sans uppercase tracking-[0.25em] text-sm lg:text-lg text-neutral-700"
                                 : "font-bodoni italic font-light text-3xl lg:text-5xl";
    var tTickerStar  = isMinimal ? "text-neutral-300 text-lg lg:text-xl" : "text-brand-400 text-2xl lg:text-3xl";
}

<partial name="_QuickViewModal" />

@if (isClassic)
{
    <!-- ═══ Classic hero — full-bleed image, left headline, gold CTA ═════════ -->
    <section class="relative bg-neutral-950 text-white overflow-hidden">
        <div class="relative min-h-[78vh] lg:min-h-[88vh] flex items-center">
            @if (hasHeroImage)
            {
                <div id="hero-slider" class="absolute inset-0" data-hero-count="@heroImages.Count" data-hero-interval="5000">
                    @for (var hi = 0; hi < heroImages.Count; hi++)
                    {
                        <img src="@Img.Cld(heroImages[hi], 1800)" alt="@(siteName) campaign @(hi + 1)" decoding="async"
                             loading="@(hi == 0 ? "eager" : "lazy")" fetchpriority="@(hi == 0 ? "high" : "auto")"
                             class="hero-slide absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-[1200ms] ease-in-out @(hi == 0 ? "opacity-100" : "opacity-0")" />
                    }
                </div>
            }
            else
            {
                <div class="absolute inset-0 bg-gradient-to-br from-neutral-900 via-neutral-950 to-black"></div>
            }
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-neutral-950/85 via-neutral-950/45 to-neutral-950/10"></div>
            <div class="relative w-full max-w-7xl mx-auto px-6 lg:px-12">
                <div class="max-w-xl">
                    <h1 class="font-bodoni font-light leading-[1.05] text-4xl sm:text-5xl lg:text-6xl @goldText">@heroHeadline</h1>
                    <p class="mt-6 max-w-md text-sm sm:text-base font-light leading-relaxed text-white/70">@heroSubtext</p>
                    <a asp-controller="Products" asp-action="Index"
                       class="group mt-9 inline-flex items-center gap-3 @goldBtn text-white text-[11px] tracking-[0.25em] uppercase px-9 py-4 transition-colors duration-300">
                        @heroCta
                        <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                    </a>
                </div>
            </div>
            @if (hasHeroImage && heroImages.Count > 1)
            {
                <div id="hero-dots" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
                    @for (var hi = 0; hi < heroImages.Count; hi++)
                    {
                        <button type="button" class="hero-dot h-1.5 rounded-full transition-all duration-500 @(hi == 0 ? "w-6 bg-white" : "w-1.5 bg-white/40")" data-hero-go="@hi" aria-label="Show campaign image @(hi + 1)"></button>
                    }
                </div>
            }
        </div>
    </section>
}

@if (!isClassic)
{
<!-- ═══ Hero — asymmetric editorial split ═══════════════════════════════════ -->
<section class="relative @tHeroWrap overflow-hidden">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] lg:min-h-screen">

        <!-- Editorial column -->
        <div class="relative z-10 flex flex-col justify-between px-6 sm:px-10 lg:px-16 pt-10 pb-14 lg:py-20 order-2 lg:order-1">
            <!-- Masthead line (editorial / boutique only) -->
            @if (!isMinimal)
            {
                <div class="hidden lg:flex items-center gap-4 text-[10px] tracking-[0.4em] uppercase @tHeroFaint">
                    <span>Volume 01</span>
                    <span class="flex-1 h-px @tHeroLine"></span>
                    <span>@siteName</span>
                </div>
            }

            <!-- Display headline -->
            <div class="py-12 lg:py-0">
                <p class="text-[11px] tracking-[0.45em] uppercase @tHeroEye mb-6">@heroEyebrow</p>
                <h1 class="@tHead font-light leading-[0.92] tracking-tight text-6xl sm:text-7xl lg:text-8xl xl:text-[8.5rem]">
                    @{
                        var words = heroHeadline.Split(' ');
                        var lead  = words.Length > 1 ? string.Join(' ', words.Take(words.Length - 1)) : heroHeadline;
                        var tail  = words.Length > 1 ? words.Last() : "";
                    }
                    <span class="block">@lead</span>
                    @if (!string.IsNullOrEmpty(tail))
                    {
                        <span class="block italic @tHeroTail">@tail</span>
                    }
                </h1>
                <p class="mt-8 max-w-md text-sm sm:text-base font-light leading-relaxed @tHeroMuted">
                    @heroSubtext
                </p>
                <div class="mt-10 flex flex-col sm:flex-row gap-4">
                    <a asp-controller="Products" asp-action="Index"
                       class="group inline-flex items-center justify-center gap-3 @tBtn text-white text-[11px] tracking-[0.25em] uppercase px-9 py-4 transition-colors duration-300">
                        @heroCta
                        <span class="transition-transform duration-300 group-hover:translate-x-1">&rarr;</span>
                    </a>
                    <a asp-controller="Home" asp-action="Collections"
                       class="inline-flex items-center justify-center border @tHeroBtn2 text-[11px] tracking-[0.25em] uppercase px-9 py-4 transition-colors duration-300">
                        Discover Zephiel
                    </a>
                </div>
            </div>

            <!-- Footline / scroll cue -->
            <div class="flex items-center justify-between text-[10px] tracking-[0.35em] uppercase @tHeroFaint">
                <span>@siteName — Fine Jewellery</span>
                <span class="hidden sm:flex items-center gap-3">
                    Explore
                    <span class="w-10 h-px @tHeroLine"></span>
                </span>
            </div>
        </div>

        <!-- Image column (hidden on mobile when there's no real hero image — avoids a tall empty gradient) -->
        <div class="relative order-1 lg:order-2 @(hasHeroImage ? "min-h-[46vh]" : "hidden lg:block") lg:min-h-0 overflow-hidden">
            @if (hasHeroImage)
            {
                <div id="hero-slider" class="absolute inset-0" data-hero-count="@heroImages.Count" data-hero-interval="5000">
                    @for (var hi = 0; hi < heroImages.Count; hi++)
                    {
                        <img src="@Img.Cld(heroImages[hi], 1400)" alt="@(siteName) campaign @(hi + 1)" decoding="async"
                             loading="@(hi == 0 ? "eager" : "lazy")" fetchpriority="@(hi == 0 ? "high" : "auto")"
                             class="hero-slide absolute inset-0 w-full h-full object-cover object-center transition-opacity duration-[1200ms] ease-in-out @(hi == 0 ? "opacity-100" : "opacity-0")" />
                    }
                </div>
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-neutral-950/50 via-transparent to-transparent lg:bg-gradient-to-r lg:from-neutral-950/60 lg:via-neutral-950/5 lg:to-transparent"></div>
                @if (heroImages.Count > 1)
                {
                    <div id="hero-dots" class="absolute bottom-6 left-6 lg:bottom-10 lg:left-1/2 lg:-translate-x-1/2 flex gap-2 z-10">
                        @for (var hi = 0; hi < heroImages.Count; hi++)
                        {
                            <button type="button" class="hero-dot h-1.5 rounded-full transition-all duration-500 @(hi == 0 ? "w-6 bg-white" : "w-1.5 bg-white/40")" data-hero-go="@hi" aria-label="Show campaign image @(hi + 1)"></button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-neutral-900 to-neutral-950"></div>
            }
            @if (!isMinimal)
            {
                <!-- Oversized index number -->
                <span class="pointer-events-none absolute bottom-6 right-6 lg:bottom-10 lg:right-10 font-bodoni text-7xl lg:text-9xl leading-none text-white/15 select-none"
                      style="-webkit-text-stroke:1px rgba(255,255,255,.35);color:transparent;">01</span>
                <!-- Vertical label -->
                <span class="hidden lg:block absolute top-1/2 -translate-y-1/2 left-6 text-[10px] tracking-[0.5em] uppercase text-white/50"
                      style="writing-mode:vertical-rl;">The New Collection</span>
            }
        </div>
    </div>
</section>
}

@if (!isClassic)
{
<!-- ═══ Trust bar — static, editable in Admin → Settings → Homepage ══════════ -->
<section class="@tTicker border-t" aria-label="Why shop with us">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-10 lg:py-12 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        @for (var ti = 0; ti < tickerLabels.Count && ti < 4; ti++)
        {
            <div class="flex flex-col items-center text-center gap-3.5 lg:px-4">
                <svg class="w-7 h-7 @tTrustIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="@trustIcons[ti % trustIcons.Length]" />
                </svg>
                <span class="@tHead text-base lg:text-lg font-light leading-tight">@tickerLabels[ti]</span>
            </div>
        }
    </div>
</section>
}

@if (shopCategories.Any() && isClassic)
{
    <!-- ═══ Classic — "Our Collections" (4 tiles) ══════════════════════════════ -->
    <section class="bg-white py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="text-center mb-10 lg:mb-14">
                <h2 class="font-bodoni text-4xl lg:text-5xl font-light text-neutral-900">Our Collections</h2>
                <p class="mt-3 text-sm text-neutral-500 font-light">Discover our exquisite jewellery selection</p>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
                @foreach (var cat in classicCats)
                {
                    var cImg = string.IsNullOrWhiteSpace(cat.ImageUrl) ? "" : Img.Cld(cat.ImageUrl, 600, 760);
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug"
                       class="group relative block aspect-[3/4] overflow-hidden bg-neutral-900">
                        @if (!string.IsNullOrEmpty(cImg))
                        {
                            <img src="@cImg" alt="@cat.Name" loading="lazy" decoding="async"
                                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        }
                        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-neutral-950/10 to-transparent"></div>
                        <span class="absolute bottom-4 left-4 right-4 font-bodoni text-lg lg:text-xl font-light text-white">@cat.Name</span>
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Static trust bar (no motion) -->
    <section class="bg-stone-50 border-t border-neutral-200 py-8 lg:py-10">
        <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
            @for (var ti = 0; ti < classicTrust.Count; ti++)
            {
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6 flex-shrink-0 @goldText" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="@trustIcons[ti % trustIcons.Length]" />
                    </svg>
                    <span class="text-sm font-medium text-neutral-800">@classicTrust[ti]</span>
                </div>
            }
        </div>
    </section>
}

<!-- ═══ Shop by Category — compact image-card grid (non-classic) ════════════ -->
@if (shopCategories.Any() && !isClassic)
{
    <section class="@tCanvas py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="flex items-end justify-between mb-8 lg:mb-12">
                <div>
                    <p class="text-[11px] tracking-[0.35em] uppercase @tEyebrow mb-3">Shop by</p>
                    <h2 class="@tHead text-3xl sm:text-4xl lg:text-5xl font-light text-neutral-900 leading-none">Category</h2>
                </div>
                <a asp-controller="Products" asp-action="Index"
                   class="hidden sm:inline-block text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-600 transition-colors border-b border-neutral-300 pb-1">
                    View All &rarr;
                </a>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 lg:gap-5">
                @foreach (var cat in shopCategories)
                {
                    var cImg = string.IsNullOrWhiteSpace(cat.ImageUrl) ? "" : Img.Cld(cat.ImageUrl, 500, 500);
                    <a asp-controller="Products" asp-action="Index" asp-route-category="@cat.Slug"
                       class="group relative block aspect-square overflow-hidden bg-neutral-100 @tImgRad">
                        @if (!string.IsNullOrEmpty(cImg))
                        {
                            <img src="@cImg" alt="@cat.Name" loading="lazy" decoding="async"
                                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 group-active:scale-105" />
                            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/65 via-neutral-950/5 to-transparent"></div>
                        }
                        else
                        {
                            <div class="absolute inset-0 bg-gradient-to-br from-brand-100 via-neutral-100 to-stone-100"></div>
                        }
                        <span class="absolute bottom-2.5 left-3 right-3 @tHead text-sm sm:text-base font-light leading-tight @(string.IsNullOrEmpty(cImg) ? "text-neutral-800" : "text-white")">@cat.Name</span>
                    </a>
                }
            </div>

            <a asp-controller="Products" asp-action="Index"
               class="sm:hidden mt-5 flex items-center justify-center gap-2 border border-neutral-900/20 py-3.5 text-[11px] tracking-[0.25em] uppercase text-neutral-700">
                View All Categories &rarr;
            </a>
        </div>
    </section>
}

<!-- ═══ The Edit — asymmetric feature spread (admin-editable) ═══════════════ -->
@{
    var featOn      = await SettingsService.GetBoolAsync("home.feature.enabled", true);
    var featHeading = await SettingsService.GetAsync("home.feature.heading", "The Edit");
    var featBlocks  = new List<(string Image, string Title, string Text, string Category, string LinkText)>();
    foreach (var b in new[] { "b1", "b2" })
    {
        var img = await SettingsService.GetAsync($"home.feature.{b}.image", "");
        if (string.IsNullOrWhiteSpace(img)) continue;
        featBlocks.Add((
            img,
            await SettingsService.GetAsync($"home.feature.{b}.title", ""),
            await SettingsService.GetAsync($"home.feature.{b}.text", ""),
            await SettingsService.GetAsync($"home.feature.{b}.category", ""),
            await SettingsService.GetAsync($"home.feature.{b}.link_text", "Shop the Collection")
        ));
    }
}
@if (featOn && featBlocks.Any())
{
    <section class="bg-neutral-950 text-white py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
            @if (!string.IsNullOrWhiteSpace(featHeading))
            {
                <div class="flex items-center gap-6 mb-14">
                    <h2 class="font-bodoni text-5xl lg:text-7xl font-light leading-none">@featHeading</h2>
                    <span class="flex-1 h-px bg-white/15"></span>
                    <span class="text-[11px] tracking-[0.35em] uppercase text-white/40">Featured</span>
                </div>
            }
            <div class="grid gap-10 lg:gap-16 @(featBlocks.Count > 1 ? "lg:grid-cols-2" : "max-w-2xl")">
                @{ var fi = 0; }
                @foreach (var blk in featBlocks)
                {
                    fi++;
                    // Stagger the two blocks vertically for an editorial off-grid rhythm.
                    var offset = (featBlocks.Count > 1 && fi == 2) ? "lg:mt-24" : "";
                    <article class="@offset">
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="group block relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[900ms]" />
                                <span class="absolute top-5 left-5 font-bodoni text-5xl text-white/70"
                                      style="-webkit-text-stroke:1px rgba(255,255,255,.5);color:transparent;">@fi.ToString("00")</span>
                            </a>
                        }
                        else
                        {
                            <div class="relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Title))
                        {
                            <h3 class="font-bodoni text-3xl lg:text-4xl font-light mb-3">@blk.Title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Text))
                        {
                            <p class="text-sm text-white/55 font-light max-w-md mb-5 leading-relaxed">@blk.Text</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="inline-block text-[11px] tracking-[0.25em] uppercase text-white border-b-2 border-brand-500 pb-1 hover:text-brand-300 transition-colors">
                                @(string.IsNullOrWhiteSpace(blk.LinkText) ? "Shop the Collection" : blk.LinkText)
                            </a>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

<!-- ═══ The Selection — featured products ═══════════════════════════════════ -->
@if (showFeatured)
{
    <section class="@tCanvas py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="flex items-end justify-between mb-8 lg:mb-12">
                <div>
                    <p class="text-[11px] tracking-[0.35em] uppercase @tEyebrow mb-3">Curated for you</p>
                    <h2 class="@tHead text-3xl sm:text-4xl lg:text-5xl font-light text-neutral-900 leading-none">@featuredHeading</h2>
                </div>
                <a asp-controller="Products" asp-action="Index"
                   class="hidden md:inline-block text-[11px] tracking-[0.25em] uppercase text-neutral-500 hover:text-brand-600 transition-colors border-b border-neutral-300 pb-1">
                    View All &rarr;
                </a>
            </div>

            @if (featuredProducts.Any())
            {
                <div class="relative group/carousel">
                    @if (featuredProducts.Count > 4)
                    {
                        <button type="button" id="feat-prev" aria-label="Previous"
                                class="hidden md:flex absolute -left-5 top-[30%] -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white shadow-md border border-neutral-200 text-neutral-700 hover:bg-brand-500 hover:text-white hover:border-brand-500 items-center justify-center transition-colors">&lsaquo;</button>
                        <button type="button" id="feat-next" aria-label="Next"
                                class="hidden md:flex absolute -right-5 top-[30%] -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white shadow-md border border-neutral-200 text-neutral-700 hover:bg-brand-500 hover:text-white hover:border-brand-500 items-center justify-center transition-colors">&rsaquo;</button>
                    }
                    <div id="feat-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;">
                        @foreach (var p in featuredProducts)
                        {
                            <div class="snap-start shrink-0 w-[calc(50%-12px)] md:w-[calc(25%-18px)]">
                                <partial name="_ProductCard" model="p" />
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="group">
                            <div class="aspect-square bg-neutral-100 mb-4 overflow-hidden">
                                <div class="w-full h-full bg-gradient-to-br from-neutral-200 to-neutral-100"></div>
                            </div>
                            <div class="h-3 bg-neutral-200 rounded w-3/4 mb-2"></div>
                            <div class="h-2 bg-neutral-100 rounded w-1/3"></div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

