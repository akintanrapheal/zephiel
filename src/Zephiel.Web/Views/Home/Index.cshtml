<!-- ═══ Testimonials — social proof (admin-editable; hidden when empty) ═══════ -->
@{
    // Prefer real approved product reviews (from the controller); fall back to admin-set quotes.
    var realReviews = (ViewBag.Testimonials as List<(string Quote, string Author, int Rating)>) ?? new List<(string, string, int)>();
    var reviews = new List<(string Quote, string Author, int Rating)>();
    if (realReviews.Any())
    {
        reviews = realReviews;
    }
    else
    {
        for (var r = 1; r <= 3; r++)
        {
            var q = await SettingsService.GetAsync($"home.review_{r}_quote", "");
            if (string.IsNullOrWhiteSpace(q)) { continue; }
            reviews.Add((q.Trim(), (await SettingsService.GetAsync($"home.review_{r}_author", "")).Trim(), 5));
        }
    }
}
@if (reviews.Any())
{
    <section class="@tCanvas py-10 lg:py-14">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="text-center mb-10 lg:mb-14">
                <p class="text-[11px] tracking-[0.35em] uppercase @tEyebrow mb-3">Loved by</p>
                <h2 class="@tHead text-3xl sm:text-4xl lg:text-5xl font-light text-neutral-900 leading-none">What our customers say</h2>
            </div>
            <div class="grid gap-6 lg:gap-8 @(reviews.Count == 1 ? "max-w-xl mx-auto" : reviews.Count == 2 ? "sm:grid-cols-2 max-w-3xl mx-auto" : "sm:grid-cols-3")">
                @foreach (var rv in reviews)
                {
                    <figure class="bg-white border border-neutral-200 @(isBoutique ? "rounded-2xl" : "rounded-xl") p-7 flex flex-col">
                        <div class="flex gap-1 mb-4" aria-label="@rv.Rating out of 5 stars">
                            @for (var s = 0; s < 5; s++)
                            {
                                <svg class="w-4 h-4 @(s < rv.Rating ? "text-brand-500" : "text-neutral-300")" fill="currentColor" viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 15l-5.3 2.6 1-5.8L1.5 7.7l5.9-.9z"/></svg>
                            }
                        </div>
                        <blockquote class="flex-1 text-sm leading-relaxed text-neutral-600 font-light">&ldquo;@rv.Quote&rdquo;</blockquote>
                        @if (!string.IsNullOrWhiteSpace(rv.Author))
                        {
                            <figcaption class="mt-5 text-xs tracking-[0.15em] uppercase text-neutral-500">@rv.Author</figcaption>
                        }
                    </figure>
                }
            </div>
        </div>
    </section>
}

