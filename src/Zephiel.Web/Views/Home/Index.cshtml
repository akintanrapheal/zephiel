<!-- ═══ Newsletter — full-bleed editorial statement ═════════════════════════ -->
<section class="relative bg-neutral-950 text-white overflow-hidden" aria-label="Newsletter signup">
    <span class="pointer-events-none absolute -top-10 -right-6 lg:right-10 font-bodoni italic text-[9rem] lg:text-[16rem] leading-none text-white/5 select-none">&#10022;</span>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-16 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 items-center">
        <div>
            <p class="text-[11px] tracking-[0.4em] uppercase text-brand-300 mb-5">Enjoy amazing discounts</p>
            <h2 class="font-bodoni text-5xl lg:text-7xl font-light leading-[0.95]">
                Join the <span class="italic text-brand-300">List</span>
            </h2>
            <p class="mt-6 max-w-md text-sm text-white/55 font-light leading-relaxed">
                Be first to see new arrivals, private previews and members-only offers.
            </p>
        </div>
        <form id="newsletter-form" class="w-full">
            <div class="flex flex-col sm:flex-row gap-3 max-w-lg lg:ml-auto">
                <input id="newsletter-email" name="email" type="email" required placeholder="Your email address" aria-label="Email address"
                       class="flex-1 bg-transparent border-b border-white/30 text-white placeholder-white/40 px-1 py-3 text-sm focus:outline-none focus:border-brand-400 transition-colors" />
                <button type="submit"
                        class="shrink-0 bg-white text-neutral-950 text-[11px] tracking-[0.25em] uppercase px-9 py-3.5 hover:bg-brand-500 hover:text-white transition-colors duration-300 disabled:opacity-60">
                    Sign Up
                </button>
            </div>
            <p id="newsletter-msg" class="text-sm mt-4 min-h-[1.25rem] max-w-lg lg:ml-auto"></p>
        </form>
    </div>
</section>

@section Scripts {
<script nonce="@Context.Items["csp-nonce"]">
// Hero campaign slider — crossfades between the configured hero images.
(function () {
    const slider = document.getElementById('hero-slider');
    if (!slider) return;
    const slides = Array.from(slider.querySelectorAll('.hero-slide'));
    const dots = Array.from(document.querySelectorAll('.hero-dot'));
    if (slides.length < 2) return;
    const interval = parseInt(slider.dataset.heroInterval, 10) || 5000;
    let i = 0, timer = null;
    function show(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, k) => { s.classList.toggle('opacity-100', k === i); s.classList.toggle('opacity-0', k !== i); });
        dots.forEach((d, k) => {
            d.classList.toggle('w-6', k === i); d.classList.toggle('bg-white', k === i);
            d.classList.toggle('w-1.5', k !== i); d.classList.toggle('bg-white/40', k !== i);
        });
    }
    function next() { show(i + 1); }
    function start() { stop(); if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = setInterval(next, interval); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    dots.forEach(d => d.addEventListener('click', () => { show(parseInt(d.dataset.heroGo, 10)); start(); }));
    start();
})();

// Newsletter signup
(function () {
    const form = document.getElementById('newsletter-form');
    if (!form) return;
    const msg = document.getElementById('newsletter-msg');
    const btn = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('newsletter-email').value.trim();
        btn.disabled = true; msg.textContent = ''; msg.className = 'text-sm mt-4 min-h-[1.25rem] max-w-lg lg:ml-auto text-white/70';
        try {
            const res = await fetch('/Home/Subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(email)
            });
            const data = await res.json();
            msg.textContent = data.message;
            msg.classList.add(data.success ? 'text-emerald-400' : 'text-red-400');
            if (data.success) form.reset();
        } catch {
            msg.textContent = 'Something went wrong. Please try again.';
            msg.classList.add('text-red-400');
        } finally { btn.disabled = false; }
    });
}());

// Featured products carousel — auto-advances one card at a time, loops, pauses on interaction.
(function () {
    var track = document.getElementById('feat-track');
    if (!track) return;
    function page() { return Math.max(track.clientWidth * 0.9, 240); }
    function card() { var c = track.firstElementChild; return c ? c.getBoundingClientRect().width + 24 : page(); }
    function atEnd() { return track.scrollLeft + track.clientWidth >= track.scrollWidth - 8; }

    var next = document.getElementById('feat-next'), prev = document.getElementById('feat-prev');
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: page(), behavior: 'smooth' }); restart(); });
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -page(), behavior: 'smooth' }); restart(); });

    var timer;
    function advance() {
        if (atEnd()) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: card(), behavior: 'smooth' });
    }
    function start() { if (track.scrollWidth > track.clientWidth + 8) timer = setInterval(advance, @featuredSlideMs); }
    function stop() { clearInterval(timer); }
    function restart() { stop(); start(); }

    track.addEventListener('mouseenter', stop);
    track.addEventListener('mouseleave', start);
    track.addEventListener('touchstart', stop, { passive: true });
    track.addEventListener('touchend', function () { setTimeout(start, 4000); }, { passive: true });
    document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
    start();
}());
</script>
}
