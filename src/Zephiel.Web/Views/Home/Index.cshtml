<!-- ═══ The Edit — asymmetric feature spread (admin-editable) ═══════════════ -->
@{
    var featOn      = await SettingsService.GetBoolAsync("home.feature.enabled", true);
    var featHeading = await SettingsService.GetAsync("home.feature.heading", "The Edit");
    var featBlocks  = new List<(string Image, string Title, string Text, string Category, string LinkText)>();
    foreach (var b in new[] { "b1", "b2" })
    {
        var img = await SettingsService.GetAsync($"home.feature.{b}.image", "");
        if (string.IsNullOrWhiteSpace(img)) continue;
        featBlocks.Add((
            img,
            await SettingsService.GetAsync($"home.feature.{b}.title", ""),
            await SettingsService.GetAsync($"home.feature.{b}.text", ""),
            await SettingsService.GetAsync($"home.feature.{b}.category", ""),
            await SettingsService.GetAsync($"home.feature.{b}.link_text", "Shop the Collection")
        ));
    }
}
@if (featOn && featBlocks.Any())
{
    <section class="bg-neutral-950 text-white py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
            @if (!string.IsNullOrWhiteSpace(featHeading))
            {
                <div class="text-center mb-12 lg:mb-14">
                    <p class="text-[11px] tracking-[0.35em] uppercase text-brand-300 mb-3">Featured</p>
                    <h2 class="@tHead text-4xl lg:text-6xl font-light leading-none">@featHeading</h2>
                </div>
            }
            <div class="grid gap-10 lg:gap-16 @(featBlocks.Count > 1 ? "lg:grid-cols-2" : "max-w-2xl")">
                @{ var fi = 0; }
                @foreach (var blk in featBlocks)
                {
                    fi++;
                    // Stagger the two blocks vertically for an editorial off-grid rhythm.
                    var offset = (featBlocks.Count > 1 && fi == 2) ? "lg:mt-24" : "";
                    <article class="@offset">
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="group block relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[900ms]" />
                                <span class="absolute top-5 left-5 font-bodoni text-5xl text-white/70"
                                      style="-webkit-text-stroke:1px rgba(255,255,255,.5);color:transparent;">@fi.ToString("00")</span>
                            </a>
                        }
                        else
                        {
                            <div class="relative aspect-[4/5] overflow-hidden bg-neutral-900 mb-7">
                                <img src="@Img.Cld(blk.Image, 900)" alt="@blk.Title" loading="lazy"
                                     class="w-full h-full object-cover" />
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Title))
                        {
                            <h3 class="font-bodoni text-3xl lg:text-4xl font-light mb-3">@blk.Title</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Text))
                        {
                            <p class="text-sm text-white/55 font-light max-w-md mb-5 leading-relaxed">@blk.Text</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(blk.Category))
                        {
                            <a asp-controller="Products" asp-action="Index" asp-route-category="@blk.Category"
                               class="inline-block text-[11px] tracking-[0.25em] uppercase text-white border-b-2 border-brand-500 pb-1 hover:text-brand-300 transition-colors">
                                @(string.IsNullOrWhiteSpace(blk.LinkText) ? "Shop the Collection" : blk.LinkText)
                            </a>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

<!-- ═══ The Selection — featured products ═══════════════════════════════════ -->
@if (showFeatured && featuredProducts.Any())
{
    <section class="@tCanvas py-10 lg:py-14">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
            <div class="text-center mb-8 lg:mb-12">
                <p class="text-[11px] tracking-[0.35em] uppercase @tEyebrow mb-3">Curated for you</p>
