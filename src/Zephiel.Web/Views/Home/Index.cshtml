                        <span class="flex aspect-square w-full items-center justify-center bg-white border border-neutral-200 @(isBoutique ? "rounded-2xl" : "rounded-xl") transition-all group-hover:border-brand-400 group-hover:shadow-sm">
                            <svg class="w-11 h-11 sm:w-12 sm:h-12 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 48 48">
                                @Html.Raw(catIcon(cat.Slug))
